<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-appearance="classic" data-theme-preference="system">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= capybara_lockstep if defined?(Capybara::Lockstep) %>

    <title>
      <% if content_for?(:page_title) %>
        <%= content_for :page_title %> -
      <% end %>

      Maintenance Tasks
    </title>

    <%= csrf_meta_tags %>

    <%=
      stylesheet_link_tag(URI.join(controller.class::BULMA_CDN, "npm/bulma@1.0.4/css/bulma.min.css"),
        media: :all,
        integrity: "sha256-Z/om3xyp6V2PKtx8BPobFfo9JCV0cOvBDMaLmquRS+4=",
        crossorigin: "anonymous") unless request.xhr?
    %>

    <style>
      :root {
        --ruby-comment: #6a737d;
        --ruby-const: #e36209;
        --ruby-embexpr: #24292e;
        --ruby-ident: #6f42c1;
        --ruby-number: #005cc5;
        --ruby-keyword: #d73a49;
        --ruby-string: #032f62;
        --required-color: #ff6685;
        --mt-surface: var(--bulma-scheme-main);
        --mt-surface-hover: var(--bulma-background);
        --mt-control: #eeeeef;
        --mt-control-selected: #ffffff;
        --mt-border: rgb(24 24 27 / 10%);
        --mt-text: #18181b;
        --mt-muted: #71717a;
        --mt-focus: #485fc7;
        --mt-control-shadow: 0 1px 2px rgb(24 24 27 / 12%);
        --mt-popover: #ffffff;
        --mt-popover-shadow: 0 12px 32px rgb(0 0 0 / 16%), 0 2px 8px rgb(0 0 0 / 8%);
        --mt-success-background: #ecfdf5;
        --mt-success-border: #a7f3d0;
        --mt-success-text: #065f46;
        --mt-warning-background: #fffbeb;
        --mt-warning-border: #f6d57a;
        --mt-warning-text: #92400e;
        --mt-danger-background: #fff1f2;
        --mt-danger-border: #fecdd3;
        --mt-danger-text: #be123c;
      }

      html[data-theme="dark"] {
        --ruby-comment: #8b949e;
        --ruby-const: #ffa657;
        --ruby-embexpr: #c9d1d9;
        --ruby-ident: #d2a8ff;
        --ruby-number: #79c0ff;
        --ruby-keyword: #ff7b72;
        --ruby-string: #a5d6ff;
        --required-color: #ff6685;
        --mt-surface: var(--bulma-background);
        --mt-surface-hover: var(--bulma-background-hover);
        --mt-control: #202126;
        --mt-control-selected: #3a3b44;
        --mt-border: rgb(255 255 255 / 10%);
        --mt-text: #f4f4f5;
        --mt-muted: #a1a1aa;
        --mt-focus: #7b8cff;
        --mt-control-shadow: 0 1px 2px rgb(0 0 0 / 32%);
        --mt-popover: #2c2d35;
        --mt-popover-shadow: 0 18px 40px rgb(0 0 0 / 55%), 0 2px 10px rgb(0 0 0 / 35%);
        --mt-success-background: rgb(16 185 129 / 12%);
        --mt-success-border: rgb(52 211 153 / 30%);
        --mt-success-text: #6ee7b7;
        --mt-warning-background: rgb(245 158 11 / 12%);
        --mt-warning-border: rgb(251 191 36 / 30%);
        --mt-warning-text: #fbbf24;
        --mt-danger-background: rgb(244 63 94 / 12%);
        --mt-danger-border: rgb(251 113 133 / 30%);
        --mt-danger-text: #fb7185;
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme]) {
          --ruby-comment: #8b949e;
          --ruby-const: #ffa657;
          --ruby-embexpr: #c9d1d9;
          --ruby-ident: #d2a8ff;
          --ruby-number: #79c0ff;
          --ruby-keyword: #ff7b72;
          --ruby-string: #a5d6ff;
          --required-color: #ff6685;
          --mt-surface: var(--bulma-background);
          --mt-surface-hover: var(--bulma-background-hover);
          --mt-control: #202126;
          --mt-control-selected: #3a3b44;
          --mt-border: rgb(255 255 255 / 10%);
          --mt-text: #f4f4f5;
          --mt-muted: #a1a1aa;
          --mt-focus: #7b8cff;
          --mt-control-shadow: 0 1px 2px rgb(0 0 0 / 32%);
          --mt-popover: #2c2d35;
          --mt-popover-shadow: 0 18px 40px rgb(0 0 0 / 55%), 0 2px 10px rgb(0 0 0 / 35%);
          --mt-success-background: rgb(16 185 129 / 12%);
          --mt-success-border: rgb(52 211 153 / 30%);
          --mt-success-text: #6ee7b7;
          --mt-warning-background: rgb(245 158 11 / 12%);
          --mt-warning-border: rgb(251 191 36 / 30%);
          --mt-warning-text: #fbbf24;
          --mt-danger-background: rgb(244 63 94 / 12%);
          --mt-danger-border: rgb(251 113 133 / 30%);
          --mt-danger-text: #fb7185;
        }
      }

      .ruby-comment { color: var(--ruby-comment); }
      .ruby-const { color: var(--ruby-const); }
      .ruby-embexpr-beg, .ruby-embexpr-end, .ruby-period { color: var(--ruby-embexpr); }
      .ruby-ident, .ruby-symbeg { color: var(--ruby-ident); }
      .ruby-ivar, .ruby-cvar, .ruby-gvar, .ruby-int, .ruby-imaginary, .ruby-float, .ruby-rational { color: var(--ruby-number); }
      .ruby-kw { color: var(--ruby-keyword); }
      .ruby-label, .ruby-tstring-beg, .ruby-tstring-content, .ruby-tstring-end { color: var(--ruby-string); }

      .select, select { width: 100%; }
      summary { cursor: pointer; }
      input[type="datetime-local"], input[type="date"], input[type="time"] {
        width: fit-content;
      }
	  details > summary {
        list-style: none;
      }
      summary::-webkit-details-marker {
        display: none
      }
      summary::before {
        content: '► ';
        position:absolute;
        font-size: 16px
      }
      details[open] summary:before {
        content: "▼ ";
      }

      .box {
        box-shadow: 0 0 6px 0 #0000001a,
                    0 2px 4px -1px #0000001a;
      }

      .task-card {
        cursor: pointer;
        isolation: isolate;
        position: relative;
      }

      .task-card__link::after {
        content: "";
        inset: 0;
        position: absolute;
        z-index: 1;
      }

      .task-card a:not(.task-card__link),
      .task-card button,
      .task-card input,
      .task-card select,
      .task-card textarea {
        position: relative;
        z-index: 2;
      }

      .task-card:focus-within {
        outline: 2px solid var(--mt-focus);
        outline-offset: 2px;
      }

      html[data-theme="dark"] .box {
        background-color: var(--bulma-background);
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme]) .box {
          background-color: var(--bulma-background);
        }
      }

      .label.is-required:after {
        content: " (required)";
        color: var(--required-color);
        font-size: 12px;
      }

      body {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .maintenance-navbar {
        align-items: center;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        padding-right: 0.75rem;
      }

      .maintenance-navbar__preferences {
        align-items: center;
        display: flex;
      }

      .display-menu {
        position: relative;
      }

      .display-menu__trigger {
        align-items: center;
        background: var(--mt-control);
        border: 0;
        border-radius: 8px;
        color: var(--mt-text);
        cursor: pointer;
        display: flex;
        font-size: 0.75rem;
        font-weight: 600;
        gap: 0.5rem;
        min-height: 2.5rem;
        padding: 0 0.75rem;
        transition: background-color 120ms ease, box-shadow 120ms ease, transform 120ms ease;
        user-select: none;
      }

      .display-menu__trigger::before {
        content: none !important;
        display: none;
      }

      .display-menu__trigger:hover {
        background: var(--mt-surface-hover);
      }

      .display-menu__trigger:active {
        transform: scale(0.98);
      }

      .display-menu__trigger:focus-visible {
        box-shadow: 0 0 0 2px var(--mt-focus);
        outline: none;
      }

      .display-menu__value {
        color: var(--mt-muted);
        font-weight: 500;
      }

      .display-menu__content {
        background: var(--mt-popover);
        border: 0;
        border-radius: 10px;
        box-shadow: var(--mt-popover-shadow);
        display: grid;
        gap: 1rem;
        margin-top: 0.375rem;
        padding: 0.75rem;
        position: absolute;
        right: 0;
        width: 19rem;
        z-index: 30;
      }

      .display-menu__group {
        border: 0;
        margin: 0;
        min-inline-size: 0;
        padding: 0;
      }

      .display-menu__label {
        color: var(--mt-muted);
        font-size: 0.6875rem;
        font-weight: 600;
        line-height: 1;
        margin-bottom: 0.5rem;
      }

      .preference-control {
        align-items: center;
        background: var(--mt-control);
        border: 0;
        border-radius: 8px;
        display: flex;
        gap: 2px;
        margin: 0;
        min-inline-size: 0;
        padding: 2px;
      }

      .preference-control__option {
        align-items: center;
        appearance: none;
        background: transparent;
        border: 0;
        border-radius: 6px;
        color: var(--mt-muted);
        cursor: pointer;
        display: inline-flex;
        font-family: inherit;
        font-size: 0.75rem;
        font-weight: 500;
        justify-content: center;
        line-height: 1;
        min-height: 2.25rem;
        padding: 0 0.625rem;
        flex: 1;
        transition: background-color 120ms ease, color 120ms ease, box-shadow 120ms ease, transform 120ms ease;
        white-space: nowrap;
      }

      .preference-control__option:hover {
        color: var(--mt-text);
      }

      .preference-control__option:active {
        transform: scale(0.96);
      }

      .preference-control__option:focus-visible {
        box-shadow: 0 0 0 2px var(--mt-focus);
        outline: none;
      }

      .preference-control__option[aria-pressed="true"] {
        background: var(--mt-control-selected);
        box-shadow: var(--mt-control-shadow);
        color: var(--mt-text);
      }

      html[data-appearance="refreshed"] body {
        background: var(--bulma-body-background-color);
        color: var(--mt-text);
        font-size: 0.875rem;
      }

      html[data-appearance="refreshed"] .section {
        padding: 2rem clamp(1rem, 3vw, 3rem) 4rem;
      }

      html[data-appearance="refreshed"] .section > .container {
        max-width: 80rem;
        width: 100%;
      }

      html[data-appearance="refreshed"] .tasks-index {
        margin-inline: auto;
        max-width: 72rem;
      }

      html[data-appearance="classic"] .task-tabs,
      html[data-appearance="classic"] .task-pagination,
      html[data-appearance="classic"] .task-group--empty {
        display: none;
      }

      html[data-appearance="refreshed"] .task-tabs {
        display: flex;
        margin-bottom: 1rem;
        overflow-x: auto;
        scrollbar-width: none;
      }

      html[data-appearance="refreshed"] .task-tabs::-webkit-scrollbar {
        display: none;
      }

      html[data-appearance="refreshed"] .display-menu__trigger,
      html[data-appearance="refreshed"] .display-menu__content,
      html[data-appearance="refreshed"] .preference-control {
        border: 0;
      }

      html[data-appearance="refreshed"] .task-tabs__list {
        align-items: center;
        background: var(--mt-control);
        border: 0;
        border-radius: 8px;
        display: inline-flex;
        flex: none;
        gap: 2px;
        padding: 3px;
      }

      html[data-appearance="refreshed"] .task-tabs__trigger {
        align-items: center;
        border-radius: 6px;
        color: var(--mt-muted);
        display: inline-flex;
        font-size: 0.8125rem;
        font-weight: 500;
        gap: 0.5rem;
        justify-content: center;
        line-height: 1;
        min-height: 2.25rem;
        padding: 0 0.75rem;
        text-decoration: none;
        transition-duration: 150ms;
        transition-property: background-color, box-shadow, color;
        transition-timing-function: ease-out;
        white-space: nowrap;
      }

      html[data-appearance="refreshed"] .task-tabs__trigger:hover {
        background: var(--mt-surface-hover);
        color: var(--mt-text);
      }

      html[data-appearance="refreshed"] .task-tabs__trigger.is-active {
        background: var(--mt-control-selected);
        box-shadow: var(--mt-control-shadow);
        color: var(--mt-text);
      }

      html[data-appearance="refreshed"] .task-tabs__trigger:focus-visible {
        outline: 2px solid var(--mt-focus);
        outline-offset: 2px;
      }

      html[data-appearance="refreshed"] .task-tabs__count {
        color: var(--mt-muted);
        font-size: 0.6875rem;
        font-variant-numeric: tabular-nums;
      }

      html[data-appearance="refreshed"] .task-group {
        display: none;
        margin-top: 0;
      }

      html[data-appearance="refreshed"] .task-group.is-active {
        display: block;
      }

      html[data-appearance="refreshed"] .task-group__heading {
        clip: rect(0, 0, 0, 0);
        clip-path: inset(50%);
        height: 1px;
        margin: -1px;
        overflow: hidden;
        padding: 0;
        position: absolute;
        white-space: nowrap;
        width: 1px;
      }

      html[data-appearance="refreshed"] .task-list,
      html[data-appearance="refreshed"] .task-list--new {
        background: transparent;
        border: 0;
        border-radius: 0;
        display: grid;
        gap: 0.625rem;
        grid-template-columns: minmax(0, 1fr);
      }

      html[data-appearance="refreshed"] .task-card {
        background: var(--mt-surface);
        border: 0;
        border-radius: 10px;
        box-shadow: none;
        margin: 0;
        min-width: 0;
        padding: 0.75rem 1rem;
        transition: background-color 120ms ease;
      }

      html[data-appearance="refreshed"] .task-card[data-page-visible="false"] {
        display: none;
      }

      html[data-appearance="refreshed"] .task-card:hover {
        background: var(--mt-surface-hover);
      }

      html[data-appearance="refreshed"] .task-card:focus-within {
        background: var(--mt-surface-hover);
      }

      html[data-appearance="refreshed"] .task-card__heading {
        align-items: center;
        display: grid !important;
        font-size: 0.875rem !important;
        gap: 0.75rem;
        grid-template-columns: minmax(0, 1fr) auto;
        line-height: 1.35;
        margin: 0 !important;
        min-height: 1.75rem;
      }

      html[data-appearance="refreshed"] .task-card__heading:not(:last-child) {
        margin-bottom: 0.75rem !important;
      }

      html[data-appearance="refreshed"] .task-card__link {
        min-width: 0;
        overflow-wrap: anywhere;
        text-wrap: pretty;
      }

      html[data-appearance="refreshed"] .task-card__heading .tag,
      html[data-appearance="refreshed"] .run-card .tag {
        border: 1px solid transparent;
      }

      html[data-appearance="refreshed"] .task-card__heading .tag {
        border-radius: 9999px;
        font-size: 0.6875rem;
        height: 1.5rem;
        justify-self: end;
        line-height: 1;
        margin: 0 !important;
        padding: 0 0.5rem !important;
      }

      html[data-appearance="refreshed"] .tag[data-status="cancelling"],
      html[data-appearance="refreshed"] .tag[data-status="cancelled"] {
        background-color: var(--mt-control);
        border-color: var(--mt-border);
        color: var(--mt-text);
      }

      html[data-appearance="refreshed"] .task-group--new .task-card .tag {
        display: none;
      }

      html[data-appearance="refreshed"] .task-card__timestamp {
        color: var(--mt-muted);
        font-size: 0.75rem !important;
        font-variant-numeric: tabular-nums;
        margin-bottom: 0.5rem;
      }

      html[data-appearance="refreshed"] .task-card .content {
        font-size: 0.8125rem;
        line-height: 1.5;
      }

      html[data-appearance="refreshed"] .task-card .content:last-child,
      html[data-appearance="refreshed"] .task-card .block:last-child {
        margin-bottom: 0;
      }

      html[data-appearance="refreshed"] .task-card .progress {
        height: 0.375rem;
        margin-top: 0.75rem !important;
      }

      html[data-appearance="refreshed"] .task-card hr {
        background-color: transparent;
        height: 0;
        margin-block: 0.75rem;
      }

      html[data-appearance="refreshed"] .task-pagination {
        align-items: center;
        color: var(--mt-muted);
        display: flex;
        font-size: 0.75rem;
        justify-content: space-between;
        margin-top: 0.75rem;
        min-height: 2.5rem;
      }

      html[data-appearance="refreshed"] .task-pagination__summary {
        font-variant-numeric: tabular-nums;
        margin: 0;
      }

      html[data-appearance="refreshed"] .task-pagination__summary span {
        color: var(--mt-text);
        font-weight: 500;
      }

      html[data-appearance="refreshed"] .task-pagination__controls,
      html[data-appearance="refreshed"] .task-pagination__size-form,
      html[data-appearance="refreshed"] .task-pagination__navigation {
        align-items: center;
        display: flex;
      }

      html[data-appearance="refreshed"] .task-pagination__controls {
        gap: 0.5rem;
      }

      html[data-appearance="refreshed"] .task-pagination__size-form {
        gap: 0.5rem;
      }

      html[data-appearance="refreshed"] .task-pagination__label {
        color: var(--mt-muted);
        font-size: 0.75rem;
        font-weight: 500;
      }

      html[data-appearance="refreshed"] .task-pagination__select-shell {
        display: inline-flex;
        position: relative;
      }

      html[data-appearance="refreshed"] .task-pagination__select-shell::after {
        border-bottom: 1.5px solid var(--mt-muted);
        border-right: 1.5px solid var(--mt-muted);
        content: "";
        height: 0.375rem;
        pointer-events: none;
        position: absolute;
        right: 0.75rem;
        top: 50%;
        transform: translateY(-65%) rotate(45deg);
        width: 0.375rem;
      }

      html[data-appearance="refreshed"] .task-pagination__select {
        appearance: none;
        background: var(--mt-control);
        border: 0;
        border-radius: 7px;
        color: var(--mt-text);
        cursor: pointer;
        font-family: inherit;
        font-size: 0.75rem;
        font-variant-numeric: tabular-nums;
        font-weight: 500;
        height: 2.5rem;
        line-height: 1;
        padding: 0 2rem 0 0.75rem;
        transition-duration: 150ms;
        transition-property: background-color, box-shadow;
        transition-timing-function: ease-out;
        width: auto;
      }

      html[data-appearance="refreshed"] .task-pagination__select:hover {
        background: var(--mt-surface-hover);
      }

      html[data-appearance="refreshed"] .task-pagination__select:focus-visible {
        box-shadow: 0 0 0 2px var(--mt-focus);
        outline: none;
      }

      html[data-appearance="refreshed"] .task-pagination__navigation {
        background: var(--mt-control);
        border: 0;
        border-radius: 8px;
        gap: 1px;
        padding: 0;
      }

      html[data-appearance="refreshed"] .task-pagination__button {
        align-items: center;
        border-radius: 6px;
        color: var(--mt-text);
        display: inline-flex;
        font-size: 0.75rem;
        font-weight: 500;
        justify-content: center;
        min-height: 2.5rem;
        min-width: 4.5rem;
        padding: 0 0.625rem;
        text-decoration: none;
        transition-duration: 150ms;
        transition-property: background-color, color, transform;
        transition-timing-function: ease-out;
      }

      html[data-appearance="refreshed"] a.task-pagination__button:hover {
        background: var(--mt-control-selected);
        color: var(--mt-text);
      }

      html[data-appearance="refreshed"] a.task-pagination__button:active {
        transform: scale(0.96);
      }

      html[data-appearance="refreshed"] a.task-pagination__button:focus-visible {
        box-shadow: 0 0 0 2px var(--mt-focus);
        outline: none;
      }

      html[data-appearance="refreshed"] .task-pagination__button[aria-disabled="true"] {
        color: var(--mt-muted);
        cursor: not-allowed;
        opacity: 0.55;
      }

      html[data-appearance="refreshed"] .tasks-index__empty-state {
        background: var(--mt-surface);
        border: 0;
        border-radius: 10px;
        padding: 2rem;
      }

      html[data-appearance="refreshed"] .tasks-index__empty-state .title {
        font-size: 1.125rem;
      }

      html[data-appearance="refreshed"] .task-group__empty-state {
        align-items: center;
        border: 0;
        border-radius: 10px;
        color: var(--mt-muted);
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 12rem;
        padding: 2rem;
        text-align: center;
      }

      html[data-appearance="refreshed"] .task-group__empty-title {
        color: var(--mt-text);
        font-size: 0.875rem;
        font-weight: 600;
        margin-bottom: 0.375rem;
      }

      html[data-appearance="refreshed"] .task-group__empty-state p {
        font-size: 0.8125rem;
        margin: 0;
        text-wrap: pretty;
      }

      html[data-appearance="classic"] .run-card__body {
        display: contents;
      }

      html[data-appearance="classic"] .task-file-upload__dropzone {
        display: none;
      }

      html[data-appearance="refreshed"] .run-pagination-classic {
        display: none !important;
      }

      html[data-appearance="refreshed"] .task-show {
        margin-inline: auto;
        max-width: 72rem;
      }

      html[data-appearance="refreshed"] .task-show__header {
        margin-bottom: 1.25rem;
      }

      html[data-appearance="refreshed"] .task-show__title {
        font-size: clamp(1.25rem, 2.4vw, 1.625rem);
        line-height: 1.25;
        margin: 0;
        overflow-wrap: anywhere;
        text-wrap: balance;
      }

      html[data-appearance="refreshed"] .task-run-form-shell {
        margin-bottom: 1.25rem;
      }

      html[data-appearance="refreshed"] .task-run-form {
        display: flex;
        flex-direction: column;
        gap: 0.875rem;
      }

      html[data-appearance="refreshed"] .task-run-form:has(.task-run-form__field, .grid) {
        background: var(--mt-surface);
        border: 0;
        border-radius: 10px;
        padding: 1rem;
      }

      html[data-appearance="refreshed"] .task-run-form .grid {
        gap: 0.875rem;
        margin: 0;
      }

