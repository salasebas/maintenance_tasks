        }

        html[data-appearance="refreshed"] .task-show__header {
          margin-bottom: 1rem;
        }

        html[data-appearance="refreshed"] .task-run-form__submit,
        html[data-appearance="refreshed"] .task-runs__refresh-control .button,
        html[data-appearance="refreshed"] .task-pagination__select,
        html[data-appearance="refreshed"] .task-pagination__button,
        html[data-appearance="refreshed"] .run-card__actions .button {
          height: 2.75rem;
          min-height: 2.75rem;
        }

        html[data-appearance="refreshed"] .task-run-form:has(.task-run-form__field, .grid) {
          padding: 0.75rem;
        }

        html[data-appearance="refreshed"] .task-file-upload__dropzone {
          grid-template-columns: 1fr;
          min-height: 5.5rem;
        }

        html[data-appearance="refreshed"] .task-file-upload__name {
          grid-column: 1;
        }

        html[data-appearance="refreshed"] .run-card__summary {
          align-items: flex-start !important;
          gap: 0.5rem;
          min-height: 3.25rem;
          padding: 0.75rem;
        }

        html[data-appearance="refreshed"] .run-card__identity {
          align-items: flex-start !important;
          flex-wrap: wrap;
        }

        html[data-appearance="refreshed"] .run-card__time {
          font-size: 0.75rem;
          width: 100%;
        }

        html[data-appearance="refreshed"] .run-card .tag {
