<nav class="navbar maintenance-navbar" role="navigation" aria-label="Main navigation">
  <div class="navbar-brand">
    <%= link_to 'Maintenance Tasks', root_path, class: 'navbar-item is-size-4 has-text-weight-semibold has-text-danger' %>
  </div>

  <div class="maintenance-navbar__preferences" role="group" aria-label="Display preferences">
    <details class="display-menu">
      <summary class="display-menu__trigger" aria-label="Display preferences">
        <span>Display</span>
        <span class="display-menu__value" data-display-preference-summary>Classic · System</span>
      </summary>

      <div class="display-menu__content">
        <fieldset class="display-menu__group" data-preference-control="appearance">
          <legend class="display-menu__label">Layout</legend>
          <div class="preference-control">
            <button class="preference-control__option" type="button" data-preference-value="classic" aria-pressed="true">
              Classic
            </button>
            <button class="preference-control__option" type="button" data-preference-value="modern" aria-pressed="false">
              Modern
            </button>
          </div>
        </fieldset>

        <fieldset class="display-menu__group" data-preference-control="theme">
          <legend class="display-menu__label">Theme</legend>
          <div class="preference-control">
            <button class="preference-control__option" type="button" data-preference-value="system" aria-pressed="true">
              System
            </button>
            <button class="preference-control__option" type="button" data-preference-value="light" aria-pressed="false">
              Light
            </button>
            <button class="preference-control__option" type="button" data-preference-value="dark" aria-pressed="false">
              Dark
            </button>
          </div>
        </fieldset>
      </div>
    </details>
  </div>
</nav>
